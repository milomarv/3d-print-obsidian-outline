# Drop this at <vault>/.outline.toml or ~/.config/3d-print-outline/config.toml
# to override the built-in defaults. Any subset of these keys may be set;
# missing keys fall through to defaults.

[extensions]
# Parametric / native CAD source. Solidworks: sldprt, sldasm, slddrw, sldlfp.
# Cross-CAD: step/stp, iges/igs. Fusion 360: f3d. OpenSCAD: scad.
# Plus generic source: obj, ipt, x_t, x_b, 3dm, prt.
cad   = ["step", "stp", "iges", "igs", "f3d", "scad", "obj", "sldprt", "sldasm", "slddrw", "sldlfp", "ipt", "x_t", "x_b", "3dm", "prt"]
stl   = ["stl"]
slice = ["3mf", "gcode", "bgcode"]
image = ["jpg", "jpeg", "png", "heic", "webp"]
sliced = []

[layout]
project_root     = "projects"
maintenance_root = "maintenance"

[layout.project_subdirs]
cad = "cad"
stl = "stl"
slice = "3mf"
image = "images"
sliced = "sliced"

[exclude]
dirs  = [".obsidian", ".trash", ".git", ".stfolder", ".stversions"]
globs = ["*.tmp", "~$*"]

[render]
fence_begin = "<!-- BEGIN AUTO -->"
fence_end   = "<!-- END AUTO -->"
header      = "<!-- AUTO-GENERATED by 3d-print-outline; do not edit between AUTO fences -->"

[spoolman]
base_url        = "https://homenet.tale-alioth.ts.net/spoolman/api/v1"
ui_base_url     = "https://homenet.tale-alioth.ts.net/spoolman"
timeout_seconds = 5
enabled         = true
